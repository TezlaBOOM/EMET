APP_NAME=Projekt-Emet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=agenthub
DB_USERNAME=agenthub
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=agenthub_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

REVERB_APP_ID=agenthub
REVERB_APP_KEY=agenthub-key
REVERB_APP_SECRET=agenthub-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME="http"

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# =============================================================================
# AgentHub Configuration
# =============================================================================
SERVICE_MODE=local

VECTOR_STORE_DRIVER=qdrant
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=

INSTANCE_DATA_DIR=storage/instances
INSTANCE_CONFIG_DIR=storage/instances/configs
INSTANCE_PORT_MIN=9000
INSTANCE_PORT_MAX=9999
INSTANCE_MAX=20
INSTANCE_RECONCILE_INTERVAL=30

ALLOW_PROMPT_LOGGING=true
LLM_DEFAULT_POOL=default
LLM_COOLDOWN_SECONDS=60
